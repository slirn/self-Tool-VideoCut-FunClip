# Python
*.pyc
**/.DS_Store
**/__pycache__/
*.spec

# Virtual env
.venv

# Gradio runtime artifacts
.gradio/
*.pem

# Output directories (generated pipeline artifacts)
ClipVideo/clipvideo/output
slirn/output/
slirn/.temp/

# Root-level generated artifacts (moviepy temp cuts, ffmpeg temp)
# Source materials under slirn/material/ are NOT excluded.
/*.mp4
/*.srt
/*.log

# CDP 烟测缓存（workbench HTML dump，由 tests/ 下的 _check_ai.py / check_render.py 等写）
/wb_*.json
/wb_response.html

# Slirn home runtime temp (moviepy cuts, gradio api info dump)
/.temp/
/_info.json
# CDP smoke dump of the slirn home page (when nav/click fails mid-test)
/slirn_home.html

# REQ 验证工作区（本机留存的测试脚本 + 产物，见 work/REQ-*/README.md）
/work/

# Local skill junctions/symlinks (created by setup-junctions.*, not tracked)
/.claude/skills/video-*
/.claude/skills/long-*
/.claude/skills/course-*
/.claude/skills/manual-*

# 公共热词库为运行时数据（界面维护；缺失时 HotwordLibrary 自动创建）
/hotwords/
tmp_test_vid/

# REQ-20260921-NNN-git-push：本地调试脚本 + 任务数据目录不入库
# - _debug_*.py：一次性手动调试脚本（本机留存，需要时再写）
# - tests/_check_*.py：CDP/AI 验证脚本（不在正式测试集 _test_*.py 命名空间）
# - /tasks/ + /slirn_home/tasks/：本机跑流程生成的真实任务数据（含敏感路径）
/_debug_*.py
/_debug_*.sh
/tests/_check_*.py
/tasks/
/slirn_home/tasks/
